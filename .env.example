# ---- Telephony (Twilio free trial) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
MY_VERIFIED_NUMBER=+91xxxxxxxxxx

# ---- Speech-to-Text (Deepgram, $200 free credit) ----
DEEPGRAM_API_KEY=your_deepgram_key

# ---- Public tunnel (ngrok free) ----
NGROK_AUTHTOKEN=your_ngrok_authtoken

# ---- Provider selection (swap to "mock" to run with no accounts) ----
STT_PROVIDER=deepgram      # deepgram | mock
TTS_PROVIDER=edge          # edge | mock
TELEPHONY_PROVIDER=twilio  # twilio | mock

# ---- TTS voice ----
TTS_VOICE=en-US-AriaNeural

# ---- Server ----
PUBLIC_HOST=                # auto-filled by ngrok at runtime if blank
PORT=5050
